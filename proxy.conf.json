[
    {
        "match": "^/jupyter/(\\d+).*",
        "type": "jupyter",
        "name": "Jupyter",
        "remotePort": 8888,
        "ws": true
    },
    {
        "match": "^/code/(\\d+).*",
        "type": "service",
        "name": "VSCode",
        "remotePort": 8080,
        "ws": true,
        "pathRewrite": {
            "^/code/\\d+/": "/"
        }
    },
    {
        "match": "^/visafs/(\\d+).*",
        "type": "service",
        "name": "Visa Files",
        "remotePort": 8090,
        "pathRewrite": {
            "^/visafs/\\d+/": "/"
        }
    },
    {
        "match": "^/ws/print/(\\d+).*",
        "type": "service",
        "name": "Visa Printing",
        "remotePort": 8091,
        "pathRewrite": {
            "^/ws/print/\\d+/": "/socket.io/"
        },
        "ws": true
    }
]
